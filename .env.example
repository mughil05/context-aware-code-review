# Documentation template only: .env is not loaded by the scaffold.
# Export chosen values in your shell when model adapters are implemented.
REVIEW_PROVIDER=openai
REVIEW_MODEL=
VERIFY_PROVIDER=
VERIFY_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
JUDGE_PROVIDER=
JUDGE_MODEL=
# Credentials will use provider-specific environment variables.
# Never store credentials in experiment configuration or result files.

# Optional read-only public GitHub acquisition; export in your shell.
GITHUB_TOKEN=

# Required for baseline model calls; never committed or stored in results.
OPENAI_API_KEY=
